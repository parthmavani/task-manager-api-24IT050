{
  "name": "task-manager-api",
  "version": "1.0.0",
  "description": "Express RESTful API Task Management system with Middleware Pipeline",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:legacy": "node test.js",
    "benchmark": "node benchmark-cache.js",
    "demo:events": "node demonstrate-events.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps"
  },
  "keywords": [
    "express",
    "rest",
    "crud",
    "middleware",
    "node"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
